<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    NuGet package: published to nuget.org as "Proxeno.Kiln".
    Package-ID-only rename: AssemblyName/RootNamespace stay "Kiln" (set from the
    project name in Directory.Build.props), so consumers keep `using Kiln;`.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Proxeno.Kiln</PackageId>
    <Authors>Kiln contributors</Authors>
    <Description>Pure-managed SIMD H.264 baseline-profile encoder for real-time streaming. No native dependencies; NEON, AVX2 and SSSE3 accelerated.</Description>
    <Copyright>Copyright (c) Kiln contributors</Copyright>
    <PackageReleaseNotes>0.6.0 — The rate controller now consumes the network feedback it always advertised. EstimatedAvailableBitrateBps acts as a hard bitrate ceiling (loss and RTT heuristics still cut below it, so a stale estimator cannot mask congestion). Jitter is a queueing early warning that holds bitrate increases without ever triggering a cut. ClientDecodeDelay drives the speed/fps/resolution complexity cascade and never touches bitrate or QP — a client falling behind is a different problem from network congestion. FIXED: the severe-congestion RTT test used an absolute 100 ms threshold, so any link with a higher baseline RTT sat permanently in severe congestion; it is now baseline-relative, as is the recovery gate, which previously used an absolute 40 ms and could leave a high-baseline link unable to walk back up after a loss episode. Callers who supply none of these fields get decisions identical to 0.5.0, verified against a 600-frame decision transcript captured from the 0.5.0 controller. Encoding is byte-identical to 0.5.0.</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Proxeno/kiln</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Proxeno/kiln</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>h264;avc;encoder;video;simd;realtime;streaming;csharp;dotnet;codec;video-encoding;webrtc;h264-encoder</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SourceLink + symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SemVer 0.x from git tags (MinVer), tag prefix "v" -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Tests" />
    <InternalsVisibleTo Include="Kiln.Benchmarks" />
    <InternalsVisibleTo Include="KilnWeftPilotHarness" />
  </ItemGroup>

  <!--
    EXPERIMENTAL, opt-in, off by default: the Weft batch-SAD pilot (branch weft-pilot/motion-sad).

      dotnet build -c Release -p:KilnWeftPilot=true -p:WeftRepoRoot=/abs/path/to/weft/

    Without -p:KilnWeftPilot=true nothing below applies: KILN_WEFT_PILOT is undefined, so
    src/Kiln/Internal/H264/H264WeftPilot.Weft.cs compiles to nothing, no Weft ProjectReference is
    added, and the build has no dependency on a Weft checkout existing at all. That is the point —
    kiln's ordinary build story is untouched on every machine, with or without Weft present.

    WeftRepoRoot defaults to a sibling checkout (../weft/) and is overridable, because this branch
    is also built against Weft worktrees that sit at a different relative depth.
  -->
  <PropertyGroup Condition="'$(KilnWeftPilot)' == 'true'">
    <WeftRepoRoot Condition="'$(WeftRepoRoot)' == ''">$(MSBuildThisFileDirectory)../../../weft/</WeftRepoRoot>
    <DefineConstants>$(DefineConstants);KILN_WEFT_PILOT</DefineConstants>
    <!--
      THE Kiln.slnx DEBUG FOOT-GUN, AND ITS ROOT-CAUSE FIX.

      The Weft projects cannot be members of Kiln.slnx: WeftRepoRoot is a build-time property and a
      solution file has to name its projects statically. When MSBuild builds a solution it runs
      every ProjectReference through AssignProjectConfiguration, which maps in-solution references
      via the solution's configuration table. An OUT-of-solution reference has no row in that table,
      and MSBuild's default response outside Visual Studio (ShouldUnsetParentConfigurationAndPlatform
      defaults to true) is to STRIP Configuration/Platform from the global properties passed down —
      so the referenced project builds at its own default, which is Debug.

      Observed before this line, on both arm64 and x86:
        dotnet build -c Release -p:KilnWeftPilot=true ... Kiln.slnx
          Kiln    -> src/Kiln/bin/Release/net10.0/Kiln.dll        <- Release
          Weft.Ir -> src/Weft.Ir/bin/DEBUG/net10.0/Weft.Ir.dll    <- unoptimized, silently

      Anyone benchmarking the pilot through the solution measured an unoptimized Weft and would
      conclude Weft is far slower than it is. Setting this false makes the parent's Configuration
      flow to the Weft references. It is scoped to the pilot: without KilnWeftPilot=true there are
      no out-of-solution references, and this property is never set.
    -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <Target Name="KilnWeftPilotCheck" BeforeTargets="BeforeBuild" Condition="'$(KilnWeftPilot)' == 'true'">
    <Error Condition="!Exists('$(WeftRepoRoot)src/Weft.Kernels/Weft.Kernels.csproj')"
           Text="KilnWeftPilot=true but no Weft checkout at '$(WeftRepoRoot)'. Pass -p:WeftRepoRoot=/abs/path/to/weft/ (trailing slash)." />
  </Target>

  <!--
    BUILD-TIME GUARD for the same foot-gun. The property above fixes the cause; this target proves
    it stayed fixed, on every build, whatever the entry point (solution, project file, IDE, a future
    MSBuild whose defaults differ). It reads the paths the Weft references actually RESOLVED to and
    fails if any of them did not land in this build's configuration.

    A README line would not survive; a build error cannot be forgotten.
  -->
  <Target Name="KilnWeftPilotConfigurationGuard"
          AfterTargets="ResolveProjectReferences"
          Condition="'$(KilnWeftPilot)' == 'true' and '$(Configuration)' != ''">
    <ItemGroup>
      <_KilnWeftResolvedRef Include="@(_ResolvedProjectReferencePaths)"
                            Condition="$([System.String]::Copy('%(Filename)').StartsWith('Weft.'))" />
      <_KilnWeftWrongConfig Include="@(_KilnWeftResolvedRef)"
                            Condition="!$([System.String]::Copy('%(Identity)').Replace('\', '/').Contains('/bin/$(Configuration)/'))" />
    </ItemGroup>
    <Error Condition="'@(_KilnWeftResolvedRef)' == ''"
           Text="KilnWeftPilot=true but no Weft.* project reference resolved. The pilot would compile against nothing; refusing to produce a binary that silently is not the pilot." />
    <Error Condition="'@(_KilnWeftWrongConfig)' != ''"
           Text="Kiln is building '$(Configuration)' but these Weft references resolved to a DIFFERENT configuration: @(_KilnWeftWrongConfig, '%0A  '). This is the Kiln.slnx foot-gun (see the ShouldUnsetParentConfigurationAndPlatform comment above): a Release Kiln linked against a Debug Weft benchmarks as an unoptimized Weft and the number is meaningless. Build the project file directly, or restore the configuration flow, before trusting any measurement." />
  </Target>

  <ItemGroup Condition="'$(KilnWeftPilot)' == 'true'">
    <ProjectReference Include="$(WeftRepoRoot)src/Weft.Kernels/Weft.Kernels.csproj" />
    <ProjectReference Include="$(WeftRepoRoot)src/Weft.Backends.Cpu/Weft.Backends.Cpu.csproj" />
    <ProjectReference Include="$(WeftRepoRoot)src/Weft.Optimizer/Weft.Optimizer.csproj" />
    <ProjectReference Include="$(WeftRepoRoot)src/Weft.Ir/Weft.Ir.csproj" />
  </ItemGroup>

</Project>
