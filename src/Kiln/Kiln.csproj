<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    NuGet package: published to nuget.org as "Proxeno.Kiln".
    Package-ID-only rename: AssemblyName/RootNamespace stay "Kiln" (set from the
    project name in Directory.Build.props), so consumers keep `using Kiln;`.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Proxeno.Kiln</PackageId>
    <Authors>Kiln contributors</Authors>
    <Description>Pure-managed SIMD H.264 baseline-profile encoder for real-time streaming. No native dependencies; NEON, AVX2 and SSSE3 accelerated.</Description>
    <Copyright>Copyright (c) Kiln contributors</Copyright>
    <PackageReleaseNotes>0.2.0 — FIX: P_Skip motion vectors were derived incorrectly when a neighbouring macroblock used a non-zero reference index (ITU-T H.264 8.4.1.1), so the encoder's reconstruction could diverge from a conformant decoder's and compound into visible drift on motion content; upgrading is recommended. Frame dimensions no longer need to be multiples of 16 — sizes such as 1920x1080 are supported via SPS frame cropping (dimensions must be even). BREAKING: Width/Height are now display dimensions, with new CodedWidth/CodedHeight for the macroblock-aligned size, and LastReconstructedY/U/V return the uncropped coded plane. LevelIdc now defaults to 0 (auto-select from frame size). Output quality is substantially better on moving content and no longer varies with SliceCount. See the GitHub release notes for the full list.</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Proxeno/kiln</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Proxeno/kiln</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>h264;avc;encoder;video;simd;realtime;streaming;csharp;dotnet;codec;video-encoding;webrtc;h264-encoder</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SourceLink + symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SemVer 0.x from git tags (MinVer), tag prefix "v" -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Tests" />
    <InternalsVisibleTo Include="Kiln.Benchmarks" />
  </ItemGroup>

</Project>
