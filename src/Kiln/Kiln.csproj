<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    NuGet package: published to nuget.org as "Proxeno.Kiln".
    Package-ID-only rename: AssemblyName/RootNamespace stay "Kiln" (set from the
    project name in Directory.Build.props), so consumers keep `using Kiln;`.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Proxeno.Kiln</PackageId>
    <Authors>Kiln contributors</Authors>
    <Description>Pure-managed SIMD H.264 baseline-profile encoder for real-time streaming. No native dependencies; NEON, AVX2 and SSSE3 accelerated.</Description>
    <Copyright>Copyright (c) Kiln contributors</Copyright>
    <PackageReleaseNotes>0.6.1 — Performance release. Encoding is byte-identical to 0.6.0 and the public API is unchanged. Motion search is faster: the sub-partition search now scores candidates four at a time with new shared-source SAD kernels (NEON on arm64, SSE2/AVX2 on x64), the 4x4 transform-domain SATD is vectorized, and the arm64 SAD kernels use fused widening accumulation. The skip pre-check reuses its prediction when the search lands on the same motion vector, and the slice scheduler wakes one worker per task instead of all of them. Measured end to end against 0.6.0 on synthetic 720p/1080p clips (paired rounds, geometric mean over content and slice counts): x64 (AMD EPYC 7713, AVX2) HighQuality 1.20x, Balanced 1.21x, Fast 1.16x, VeryFast 1.02x; arm64 (Apple M5 Max) HighQuality 1.27x, Balanced 1.23x, Fast 1.17x, VeryFast about unchanged. High-motion content gains most (up to about 1.4x on x64 and 1.8x on arm64 at HighQuality).</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Proxeno/kiln</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Proxeno/kiln</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>h264;avc;encoder;video;simd;realtime;streaming;csharp;dotnet;codec;video-encoding;webrtc;h264-encoder</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SourceLink + symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SemVer 0.x from git tags (MinVer), tag prefix "v" -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Tests" />
    <InternalsVisibleTo Include="Kiln.Benchmarks" />
  </ItemGroup>

</Project>
