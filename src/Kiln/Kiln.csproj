<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    NuGet package: published to nuget.org as "Proxeno.Kiln".
    Package-ID-only rename: AssemblyName/RootNamespace stay "Kiln" (set from the
    project name in Directory.Build.props), so consumers keep `using Kiln;`.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Proxeno.Kiln</PackageId>
    <Authors>Kiln contributors</Authors>
    <Description>Pure-managed SIMD H.264 baseline-profile encoder for real-time streaming. No native dependencies; NEON, AVX2 and SSSE3 accelerated.</Description>
    <Copyright>Copyright (c) Kiln contributors</Copyright>
    <PackageReleaseNotes>0.4.0 — New: H264StreamingSession connects Kiln.RateControl to the encoder. Feed it EncoderNetworkFeedback per frame and it applies slice QP, a per-picture bit budget, recovery IDRs and live speed-mode changes; ChangeResolution handles resolution switches. Deterministic — wall-clock is a caller-supplied input, never measured internally, so identical frames plus identical feedback give an identical bitstream. Also public: ApplySpeedMode/ApplySpeedKnobs for live reconfiguration and EncodeFrame(targetBitsPerFrame:) for per-picture budgets. Reference count is now adjustable per frame below the SPS-signalled maximum with no IDR required. Not implemented and documented as such: intra refresh (surfaced as a request, never faked), frame scaling (the caller supplies frames at the decided resolution), and frame pacing/dropping. Includes the 0.3.1 deblocking conformance fix — if you are on 0.3.0 or earlier and use AdaptiveQuantStrength or TargetBitsPerFrame, upgrading is recommended.</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Proxeno/kiln</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Proxeno/kiln</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>h264;avc;encoder;video;simd;realtime;streaming;csharp;dotnet;codec;video-encoding;webrtc;h264-encoder</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SourceLink + symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SemVer 0.x from git tags (MinVer), tag prefix "v" -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Tests" />
    <InternalsVisibleTo Include="Kiln.Benchmarks" />
  </ItemGroup>

</Project>
