<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    NuGet package: published to nuget.org as "Proxeno.Kiln".
    Package-ID-only rename: AssemblyName/RootNamespace stay "Kiln" (set from the
    project name in Directory.Build.props), so consumers keep `using Kiln;`.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Proxeno.Kiln</PackageId>
    <Authors>Kiln contributors</Authors>
    <Description>Pure-managed SIMD H.264 baseline-profile encoder for real-time streaming. No native dependencies; NEON, AVX2 and SSSE3 accelerated.</Description>
    <Copyright>Copyright (c) Kiln contributors</Copyright>
    <PackageReleaseNotes>0.6.0 — The rate controller now consumes the network feedback it always advertised. EstimatedAvailableBitrateBps acts as a hard bitrate ceiling (loss and RTT heuristics still cut below it, so a stale estimator cannot mask congestion). Jitter is a queueing early warning that holds bitrate increases without ever triggering a cut. ClientDecodeDelay drives the speed/fps/resolution complexity cascade and never touches bitrate or QP — a client falling behind is a different problem from network congestion. FIXED: the severe-congestion RTT test used an absolute 100 ms threshold, so any link with a higher baseline RTT sat permanently in severe congestion; it is now baseline-relative, as is the recovery gate, which previously used an absolute 40 ms and could leave a high-baseline link unable to walk back up after a loss episode. Callers who supply none of these fields get decisions identical to 0.5.0, verified against a 600-frame decision transcript captured from the 0.5.0 controller. Encoding is byte-identical to 0.5.0.</PackageReleaseNotes>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Proxeno/kiln</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Proxeno/kiln</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>h264;avc;encoder;video;simd;realtime;streaming;csharp;dotnet;codec;video-encoding;webrtc;h264-encoder</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- SourceLink + symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- SemVer 0.x from git tags (MinVer), tag prefix "v" -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kiln.Tests" />
    <InternalsVisibleTo Include="Kiln.Benchmarks" />
  </ItemGroup>

</Project>
